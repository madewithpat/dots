# Machine-local files — never commit
# (explicit names, not a bare *.local glob — that also matches a literal
# ".local" directory, which silently swallowed ornith/.local/bin/ here)
.DS_Store
.bashrc.local
.bash_profile.local
.gitconfig.local
.zshrc.local
*.bak
*.swp

# Neovim — generated/machine-local
nvim/.config/nvim/lazy-lock.json
nvim/.config/nvim/lazyvim.json

# Tmux — installed plugins
tmux/.config/tmux/plugins/

# omp — runtime state (session/model caches). --no-folding in stow.sh is
# the real fix (keeps these out of ~/.omp/agent/ symlinking into this repo
# in the first place) — this is belt-and-suspenders in case that ever lapses.
omp/.omp/agent/*.db
omp/.omp/agent/*.db-shm
omp/.omp/agent/*.db-wal
