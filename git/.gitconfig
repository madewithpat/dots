[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

# Machine-local default identity (gitignored, not stowed). Must come before
# the includeIf blocks below — git config resolution is order-dependent, so
# a directory-scoped override only wins if it's read *after* this default.
[include]
	path = ~/.gitconfig.local

[gpg]
  format = ssh

[commit]
	gpgsign = true

[core]
	editor = nvim
	autocrlf = input
	pager = less -FX

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[rebase]
	autoStash = true

[diff]
	colorMoved = default
	algorithm = histogram

[merge]
	conflictstyle = diff3

[color]
	ui = auto

[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset [%G?]' --abbrev-commit
	gone = !git fetch --prune && git branch -vv | grep \": gone]\" | awk '{print $1}' | xargs -r git branch -d
	Gone = !git fetch --prune && git branch -vv | grep \": gone]\" | awk '{print $1}' | xargs -r git branch -D
	st = status -sb
	p = pull
	co = checkout
	br = branch -vv
	new = checkout -b
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
	aliases = config --get-regexp alias

[includeIf "gitdir:**/mwp/"]
  path = ~/.mwp.gitconfig

[includeIf "gitdir:**/tm/"]
  path = ~/.tm.gitconfig

# Per-org SSH host-alias URL rewrites ([url "git@gh-x:org"] insteadOf =
# git@github.com:org) also belong in ~/.gitconfig.local, not here — they
# name real employer/client GitHub orgs and don't belong in a public repo.
