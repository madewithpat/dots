[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[user]
	name = Patrick Outler
	email = patrick.outler@griffinglobaltech.com
	signingkey = ~/.ssh/id_ed25519.pub

[gpg]
  format = ssh

[commit]
	gpgsign = true

[core]
	editor = nvim
	autocrlf = input
	pager = less -FX

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[rebase]
	autoStash = true

[diff]
	colorMoved = default

[merge]
	conflictstyle = diff3

[color]
	ui = auto

[alias]
	lg = log --color --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset [%G?]' --abbrev-commit
	gone = !git fetch --prune && git branch -vv | grep \": gone]\" | awk '{print $1}' | xargs -r git branch -d
	Gone = !git fetch --prune && git branch -vv | grep \": gone]\" | awk '{print $1}' | xargs -r git branch -D
	st = status -sb
	p = pull
	co = checkout
	br = branch -vv
	new = checkout -b
	undo = reset --soft HEAD~1
	amend = commit --amend --no-edit
	aliases = config --get-regexp alias

[includeIf "gitdir:**/mwp/"]
  path = ~/.mwp.gitconfig

[includeIf "gitdir:**/tm/"]
  path = ~/.tm.gitconfig

[url "git@gh:GRIFFINglobaltech"]
  insteadOf = git@github.com:GRIFFINglobaltech

[url "git@gh:ggt-patrick-outler"]
  insteadOf = git@github.com:ggt-patrick-outler

[url "git@gh-tm:taylormorrison"]
  insteadOf = git@github.com:taylormorrison

[url "git@gh-otter:OtterSolv"]
  insteadOf = git@github.com:OtterSolv

[url "git@gh-mwp:madewithpat"]
  insteadOf = git@github.com:madewithpat

# Machine-local identity and overrides (not committed)
[include]
	path = ~/.gitconfig.local
