#!/usr/bin/env bash
# Ctrl+h/j/k/l for herdr: seamless navigation across herdr panes and Neovim
# splits — the herdr half of what tmux.conf's @pane-is-vim bindings do.
#
# Bound in ~/.config/herdr/config.toml as a `type = "shell"` key command:
#   herdr-smart-nav <left|down|up|right>
#
#   1. Focused pane runs (n)vim: forward the key; smart-splits moves between
#      Neovim splits and, at Neovim's edge, calls back into herdr
#      (nvim/.config/nvim/lua/herdr_smart_splits.lua).
#   2. Otherwise move herdr focus. With no pane that way, forward the key so
#      the shell keeps it (C-l clears, C-h backspaces).
#
# Adapted from smart-splits.nvim v2's scripts/herdr-navigate.sh, which v3
# dropped along with its built-in herdr support.
set -euo pipefail

dir="${1:?usage: herdr-smart-nav <left|down|up|right>}"
herdr="${HERDR_BIN_PATH:-herdr}"
# Key commands get the pane that was focused when the key was pressed here,
# not HERDR_PANE_ID (that is only set inside a pane's own environment).
pane="${HERDR_ACTIVE_PANE_ID:?herdr-smart-nav must run from a herdr key command}"

case "$dir" in
  left) key=ctrl+h ;;
  down) key=ctrl+j ;;
  up) key=ctrl+k ;;
  right) key=ctrl+l ;;
  *)
    echo "herdr-smart-nav: unknown direction: $dir" >&2
    exit 2
    ;;
esac

# vim-tmux-navigator's matcher: vi, vim, nvim, view, gvim, vimdiff, ...
vim_re='^g?(view|l?n?vim?x?)(diff)?$'

if "$herdr" pane process-info --pane "$pane" 2>/dev/null |
  jq -e --arg re "$vim_re" \
    'any(.result.process_info.foreground_processes[]?.name; ascii_downcase | test($re))' \
    >/dev/null 2>&1; then
  exec "$herdr" pane send-keys "$pane" "$key"
fi

changed="$("$herdr" pane focus --pane "$pane" --direction "$dir" 2>/dev/null |
  jq -r '.result.focus.changed // false' 2>/dev/null)" || changed=false
if [[ "$changed" != true ]]; then
  # No neighbour, or herdr did not answer: never swallow the key.
  exec "$herdr" pane send-keys "$pane" "$key"
fi
